#!/bin/sh
# Fetches the games docs/games.md includes, each from ScummVM's official
# download and checked against a pinned SHA-256, and unpacks them whole, with
# their licences beside them, into OUT in the shape tools/tree's -d takes:
#
#   tools/fetch-games OUT [GAME ...]
#   tools/tree TREE -d OUT git+https://github.com/johnmerchant/neochumby-scummvm#REV
#
# Nothing here is committed or distributed by this repository. The game data is
# its rights holders', under the licence file in each archive: read it, and keep
# it with the files if you pass them on. The engine data (sky.cpt and so on) is
# ScummVM's own, from the release pinned as third_party/scummvm.
#
# Needs curl, python3 and sha256sum or shasum.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
[ $# -ge 1 ] || {
  echo "usage: tools/fetch-games OUT [GAME ...]" >&2
  exit 2
}
out=$1
shift
base=https://downloads.scummvm.org/frs/extras
app=$out/apps/scummvm
# Beside the data, not in it: tools/tree copies all of OUT into the tree.
cache=${XDG_CACHE_HOME:-$HOME/.cache}/neochumby-scummvm

sha256() {
  if command -v sha256sum > /dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1
}

# Each: id, directory on the server (with %20), archive, SHA-256 as ScummVM's
# games page gives it, ScummVM's own files the game needs.
catalog() {
  cat << 'EOF'
sky Beneath%20a%20Steel%20Sky BASS-Floppy-1.3.zip d0bac1bd61747a67e885fa44b78c78887bf2b15d3dfa2790c483fad651078818 sky.cpt
queen Flight%20of%20the%20Amazon%20Queen FOTAQ_Floppy.zip 2e59de85f708cdb32bf85c85b394ac091c05f7647e856b71f5b3ae73fde761e0 -
lure Lure%20of%20the%20Temptress lure-1.1.zip f3178245a1483da1168c3a11e70b65d33c389f1f5df63d4f3a356886c1890108 lure.dat
drascula Drascula_%20The%20Vampire%20Strikes%20Back drascula-1.0.zip b731f6cb5a22ba8b4c3b3362f570b9a10a67b6cb0b395394b19a94b36e4e42de drascula.dat
dreamweb Dreamweb dreamweb-uk-1.1.zip 0f98e5fbeedfff5f5b904220d3bd3288da5a272f9192da03f2160c5edb8cdfb3 -
soltys Soltys soltys-en-v1.0.zip 87b89e654b8a5b8ebe342cb4c5c6049ab9a43a5efb474d9c49bafb77dcce48f6 -
nippon Nippon%20Safes nippon-1.0.zip 53e7e2c60065e4aed193169bbcdcfd1113fa68d3efe1c8240ba073c0e20d613f -
EOF
}

wanted() {
  [ $# -gt 1 ] || return 0
  id=$1
  shift
  for g in "$@"; do [ "$g" = "$id" ] && return 0; done
  return 1
}

mkdir -p "$app/games" "$app/engine-data" "$cache"
catalog | while read -r id dir zip want data; do
  wanted "$id" "$@" || continue
  dl=$cache/$zip
  if [ ! -f "$dl" ] || [ "$(sha256 "$dl")" != "$want" ]; then
    echo "fetching $zip" >&2
    curl -fsSL -o "$dl.part" "$base/$dir/$zip"
    mv "$dl.part" "$dl"
  fi
  got=$(sha256 "$dl")
  [ "$got" = "$want" ] || {
    rm -f "$dl"
    echo "fetch-games: $zip: SHA-256 $got, not $want" >&2
    exit 1
  }
  rm -rf "$app/games/$id" "$app/games/$id.tmp"
  python3 -I -m zipfile -e "$dl" "$app/games/$id.tmp"
  # Some archives hold one directory with everything in it.
  top=$(ls -A "$app/games/$id.tmp")
  if [ "$(printf '%s\n' "$top" | wc -l)" -eq 1 ] && [ -d "$app/games/$id.tmp/$top" ]; then
    mv "$app/games/$id.tmp/$top" "$app/games/$id"
    rmdir "$app/games/$id.tmp"
  else
    mv "$app/games/$id.tmp" "$app/games/$id"
  fi
  printf '%s\nsha256 %s\nThe licence is the readme or licence file in this directory, as the archive has it.\n' \
    "$base/$dir/$zip" "$want" > "$app/games/$id/SOURCE.txt"
  [ "$data" = - ] || cp "$root/third_party/scummvm/dists/engine-data/$data" "$app/engine-data/"
  echo "$id: $(du -sk "$app/games/$id" | cut -f1) KiB" >&2
done

# Drascula's music, the Ogg Vorbis pack. The game finds it in audio/. The pack's
# own readme.txt, its licence, shares a name with the game's, so what isn't
# audio/ goes in music-pack/, whole, and neither is overwritten.
if wanted drascula "$@"; then
  zip=drascula-audio-2.0.zip
  dir=Drascula_%20The%20Vampire%20Strikes%20Back
  want=7e6afba36eed13dd02e0360119e9a6a8d0e7b334ddc11d7c46ab7faceb8fe401
  dl=$cache/$zip
  if [ ! -f "$dl" ] || [ "$(sha256 "$dl")" != "$want" ]; then
    echo "fetching $zip" >&2
    curl -fsSL -o "$dl.part" "$base/$dir/$zip"
    mv "$dl.part" "$dl"
  fi
  got=$(sha256 "$dl")
  [ "$got" = "$want" ] || {
    rm -f "$dl"
    echo "fetch-games: $zip: SHA-256 $got, not $want" >&2
    exit 1
  }
  game=$app/games/drascula
  rm -rf "$game/audio" "$game/music-pack"
  python3 -I -m zipfile -e "$dl" "$game/music-pack"
  mv "$game/music-pack/audio" "$game/audio"
  printf '%s\nsha256 %s\nThe licence is readme.txt in this directory, as the archive has it. audio/ is one level up.\n' \
    "$base/$dir/$zip" "$want" > "$game/music-pack/SOURCE.txt"
  echo "drascula music: $(du -sk "$game/audio" | cut -f1) KiB" >&2
fi
